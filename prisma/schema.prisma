generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  passwordHash String
  name      String
  role      String   @default("DEVELOPER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  apps      App[]
}

model App {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  developer   String
  category    String
  description String
  icon        String
  accent      String   @default("#7B2FF7")
  rating      Float    @default(4.5)
  featured    Boolean  @default(false)
  trending    Boolean  @default(false)
  url         String
  screenshots String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  shortDescription String?
  longDescription  String?
  iconUrl     String?
  status      String   @default("APPROVED")
  developerId String?
  owner       User?    @relation(fields: [developerId], references: [id], onDelete: SetNull)
  reviews     Review[]

  @@index([category])
  @@index([createdAt])
  @@index([status])
  @@index([developerId])
}

model Review {
  id         String   @id @default(cuid())
  appId      String
  app        App     @relation(fields: [appId], references: [id], onDelete: Cascade)
  nickname   String
  comment    String
  rating     Int
  visitorId  String
  createdAt  DateTime @default(now())

  @@unique([appId, visitorId])
  @@index([appId, createdAt])
}
