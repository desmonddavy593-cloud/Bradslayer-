generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  username  String?  @unique
  passwordHash String
  name      String
  role      String   @default("DEVELOPER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  apps      App[]
  announcementReads AnnouncementRead[]
  helpComments HelpComment[]
}

model App {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  developer   String
  category    String
  description String
  icon        String
  accent      String   @default("#7B2FF7")
  rating      Float    @default(4.5)
  featured    Boolean  @default(false)
  trending    Boolean  @default(false)
  url         String
  screenshots String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  shortDescription String?
  longDescription  String?
  iconUrl     String?
  priceXof    Int?
  status      String   @default("APPROVED")
  developerId String?
  owner       User?    @relation(fields: [developerId], references: [id], onDelete: SetNull)
  reviews     Review[]
  events      AppEvent[]

  @@index([category])
  @@index([createdAt])
  @@index([status])
  @@index([developerId])
  @@index([priceXof])
}

model Review {
  id         String   @id @default(cuid())
  appId      String
  app        App     @relation(fields: [appId], references: [id], onDelete: Cascade)
  nickname   String
  comment    String
  rating     Int
  visitorId  String
  createdAt  DateTime @default(now())

  @@unique([appId, visitorId])
  @@index([appId, createdAt])
}

model AppEvent {
  id        String   @id @default(cuid())
  appId     String
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  type      String
  visitorId String
  createdAt DateTime @default(now())

  @@index([appId, type, createdAt])
  @@index([visitorId, appId, type, createdAt])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  text      String
  createdAt DateTime @default(now())
  reads     AnnouncementRead[]

  @@index([createdAt])
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId, readAt])
}

model HelpComment {
  id        String   @id @default(cuid())
  message   String
  contact   String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

model Guide {
  id        String   @id @default(cuid())
  title     String
  excerpt   String
  content   String
  category  String   @default("Tutoriel")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([category])
}
