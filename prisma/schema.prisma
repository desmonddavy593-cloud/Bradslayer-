generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  username  String?  @unique
  passwordHash String
  name      String
  role      String   @default("DEVELOPER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  suspendedAt DateTime?
  bio       String?
  website   String?
  community String?
  accountStatus String @default("APPROVED")
  accountReason String?
  avatar    String?
  isOfficial Boolean @default(false)
  apps      App[]
  announcementReads AnnouncementRead[]
  helpComments HelpComment[]
  contactMessages ContactMessage[]
  chatThreads ChatThread[]
}

model App {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  developer   String
  category    String
  description String
  icon        String
  accent      String   @default("#7B2FF7")
  rating      Float    @default(4.5)
  featured    Boolean  @default(false)
  trending    Boolean  @default(false)
  url         String
  screenshots String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  shortDescription String?
  longDescription  String?
  iconUrl     String?
  priceXof    Int?
  status      String   @default("APPROVED")
  rejectionReason String?
  isOfficial Boolean @default(false)
  reviewedAt DateTime?
  hiddenAt DateTime?
  apkPath String?
  apkSize Int?
  apkSha256 String?
  apkOriginalName String?
  versionName String?
  developerId String?
  owner       User?    @relation(fields: [developerId], references: [id], onDelete: SetNull)
  reviews     Review[]
  events      AppEvent[]
  likes       AppLike[]
  reports     Report[]

  @@index([category])
  @@index([createdAt])
  @@index([status])
  @@index([developerId])
  @@index([priceXof])
}

model Review {
  id         String   @id @default(cuid())
  appId      String
  app        App     @relation(fields: [appId], references: [id], onDelete: Cascade)
  nickname   String
  comment    String
  rating     Int
  visitorId  String
  createdAt  DateTime @default(now())

  @@unique([appId, visitorId])
  @@index([appId, createdAt])
}

model AppEvent {
  id        String   @id @default(cuid())
  appId     String
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  type      String
  visitorId String
  createdAt DateTime @default(now())

  @@index([appId, type, createdAt])
  @@index([visitorId, appId, type, createdAt])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  text      String
  createdAt DateTime @default(now())
  reads     AnnouncementRead[]

  @@index([createdAt])
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId, readAt])
}

model HelpComment {
  id        String   @id @default(cuid())
  message   String
  contact   String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

model Guide {
  id        String   @id @default(cuid())
  title     String
  excerpt   String
  content   String
  category  String   @default("Tutoriel")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([category])
}

model AppLike {
  id        String   @id @default(cuid())
  appId     String
  visitorId String
  createdAt DateTime @default(now())
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  @@unique([appId, visitorId])
  @@index([appId, createdAt])
}

model Report {
  id        String   @id @default(cuid())
  appId     String
  reason    String
  message   String?
  visitorId String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  @@index([status, createdAt])
  @@index([appId, createdAt])
  @@unique([appId, visitorId, createdAt])
}

model AdminLog {
  id        String   @id @default(cuid())
  action    String
  target    String
  createdAt DateTime @default(now())
  @@index([createdAt])
}

model ContactMessage {
  id          String   @id @default(cuid())
  userId      String
  subject     String
  message     String
  status      String   @default("NEW")
  adminReply  String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model AdminProfile {
  id           String   @id @default(cuid())
  displayName  String
  avatar       String?
  title        String   @default("Support")
  active       Boolean  @default(true)
  doNotDisturb Boolean  @default(false)
  lastSeenAt   DateTime?
  createdAt    DateTime @default(now())
  chatThreads  ChatThread[]
}

model ChatThread {
  id            String       @id @default(cuid())
  userId        String
  adminId       String
  status        String       @default("OPEN")
  lastMessageAt DateTime      @default(now())
  createdAt     DateTime      @default(now())
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  admin         AdminProfile @relation(fields: [adminId], references: [id], onDelete: Cascade)
  messages      ChatMessage[]
  @@unique([userId, adminId, status])
  @@index([adminId, status, lastMessageAt])
}

model ChatMessage {
  id        String     @id @default(cuid())
  threadId  String
  sender    String
  body      String
  readAt    DateTime?
  createdAt DateTime   @default(now())
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  @@index([threadId, createdAt])
}

model AdminNotification {
  id        String   @id @default(cuid())
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  @@index([readAt, createdAt])
}
